    "span": "contract DeadManSwitch(pubkey owner, pubkey initHeir, int initDeadline) {\n    pubkey heir = initHeir;\n    int deadline = initDeadline;\n\n    entrypoint function keepAlive(sig s, int newDeadline) {\n        require(checkSig(s, owner));\n        require(tx.outputs[0].value >= tx.inputs[this.activeInputIndex].value);\n        validateOutputState(0, { heir: heir, deadline: newDeadline });\n    }\n\n    entrypoint function changeHeir(sig s, pubkey newHeir) {\n        require(checkSig(s, owner));\n        require(tx.outputs[0].value >= tx.inputs[this.activeInputIndex].value);\n        validateOutputState(0, { heir: newHeir, deadline: deadline });\n    }\n\n    entrypoint function topUp() {\n        require(this.activeInputIndex == 0);\n        require(tx.outputs[0].value > tx.inputs[this.activeInputIndex].value);\n        require(tx.outputs[0].scriptPubKey == tx.inputs[this.activeInputIndex].scriptPubKey);\n        validateOutputState(0, { heir: heir, deadline: deadline });\n    }\n\n    entrypoint function claim(sig s) {\n        require(checkSig(s, heir));\n        require(tx.time >= deadline);\n    }\n}",
    "name_span": "DeadManSwitch"
