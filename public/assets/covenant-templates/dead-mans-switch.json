    "span": "contract DeadManSwitch(pubkey owner, pubkey heir, int initDeadline) {\n    int deadline = initDeadline;\n\n    entrypoint function keepAlive(sig s, int newDeadline) {\n        require(checkSig(s, owner));\n        require(this.activeInputIndex == 0);\n        require(newDeadline > deadline);\n        require(tx.outputs[0].value >= tx.inputs[this.activeInputIndex].value);\n        validateOutputState(0, { deadline: newDeadline });\n    }\n\n    entrypoint function topUp() {\n        require(this.activeInputIndex == 0);\n        require(tx.outputs[0].value > tx.inputs[this.activeInputIndex].value);\n        require(tx.outputs[0].scriptPubKey == tx.inputs[this.activeInputIndex].scriptPubKey);\n        validateOutputState(0, { deadline: deadline });\n    }\n\n    entrypoint function withdraw(sig s, int amount) {\n        require(checkSig(s, owner));\n        require(this.activeInputIndex == 0);\n        require(amount > 0);\n\n        int total = tx.inputs[this.activeInputIndex].value;\n        require(amount < total);\n        byte[34] ownerLock = new ScriptPubKeyP2PK(owner);\n\n        require(tx.outputs[0].scriptPubKey == byte[](ownerLock));\n        require(tx.outputs[0].value == amount);\n        require(tx.outputs[1].scriptPubKey == tx.inputs[this.activeInputIndex].scriptPubKey);\n        require(tx.outputs[1].value == total - amount);\n        validateOutputState(1, { deadline: deadline });\n    }\n\n    entrypoint function claim(sig s) {\n        require(checkSig(s, heir));\n        require(tx.time >= deadline);\n    }\n}",
    "name_span": "DeadManSwitch"
