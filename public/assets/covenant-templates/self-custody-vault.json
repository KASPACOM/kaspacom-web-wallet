    "span": "contract SelfCustodyVault(\n    pubkey hotKey,\n    pubkey coldKey,\n    pubkey[] whitelistedDestinations,\n    int unvaultDelaySeconds,\n    int initPhase\n) {\n    int constant PHASE_LOCKED = 0;\n    int constant PHASE_UNVAULTING = 1;\n\n    int phase = initPhase;\n\n    function requireAmountAndDestinationIfNeeded(int destinationIndex) {\n        require(tx.outputs[0].value >= tx.inputs[this.activeInputIndex].value);\n\n        if (whitelistedDestinations.length > 0) {\n            require(destinationIndex >= 0);\n            require(destinationIndex < whitelistedDestinations.length);\n            require(tx.outputs[0].scriptPubKey == byte[](new ScriptPubKeyP2PK(whitelistedDestinations[destinationIndex])));\n        }\n    }\n\n    function validateVaultOutput(int outputIndex, int nextPhase) {\n        validateOutputState(outputIndex, {\n            phase: nextPhase\n        });\n    }\n\n    entrypoint function topUp() {\n        require(phase == PHASE_LOCKED);\n        require(this.activeInputIndex == 0);\n        require(OpAuthOutputCount(this.activeInputIndex) == 1);\n        require(OpAuthOutputIdx(this.activeInputIndex, 0) == 0);\n        require(tx.outputs[0].value > tx.inputs[this.activeInputIndex].value);\n        validateVaultOutput(0, PHASE_LOCKED);\n    }\n\n    entrypoint function unvault(sig hotSig) {\n        require(checkSig(hotSig, hotKey));\n        require(phase == PHASE_LOCKED);\n        require(this.activeInputIndex == 0);\n        require(OpAuthOutputCount(this.activeInputIndex) == 1);\n        require(OpAuthOutputIdx(this.activeInputIndex, 0) == 0);\n        require(tx.outputs[0].value >= tx.inputs[this.activeInputIndex].value);\n        validateVaultOutput(0, PHASE_UNVAULTING);\n    }\n\n    entrypoint function emergencySweep(sig coldSig, int destinationIndex) {\n        require(checkSig(coldSig, coldKey));\n        require(this.activeInputIndex == 0);\n        require(OpAuthOutputCount(this.activeInputIndex) == 0);\n        requireAmountAndDestinationIfNeeded(destinationIndex);\n    }\n\n    entrypoint function finalize(sig hotSig, int destinationIndex) {\n        require(checkSig(hotSig, hotKey));\n        require(phase == PHASE_UNVAULTING);\n        require(this.age >= unvaultDelaySeconds);\n        require(this.activeInputIndex == 0);\n        require(OpAuthOutputCount(this.activeInputIndex) == 0);\n        requireAmountAndDestinationIfNeeded(destinationIndex);\n    }\n}",
    "name_span": "SelfCustodyVault"
