pragma silverscript ^0.1.0;

contract SelfCustodyVault(
    pubkey hotKey,
    pubkey coldKey,
    pubkey[] whitelistedDestinations,
    int initWhitelistCount,
    int unvaultDelaySeconds,
    int initPhase
) {
    int constant PHASE_LOCKED = 0;
    int constant PHASE_UNVAULTING = 1;

    int whitelistCount = initWhitelistCount;
    int vaultUnvaultDelaySeconds = unvaultDelaySeconds;
    int phase = initPhase;

    function requireAmountAndDestinationIfNeeded(int destinationIndex) {
        require(tx.outputs[0].value >= tx.inputs[this.activeInputIndex].value);

        if (whitelistCount > 0) {
            require(destinationIndex >= 0);
            require(destinationIndex < whitelistCount);
            require(tx.outputs[0].scriptPubKey == byte[](new ScriptPubKeyP2PK(whitelistedDestinations[destinationIndex])));
        }
    }

    function validateVaultOutput(int outputIndex, int nextPhase) {
        validateOutputState(outputIndex, { whitelistCount: whitelistCount, vaultUnvaultDelaySeconds: vaultUnvaultDelaySeconds, phase: nextPhase });
    }

    entrypoint function topUp() {
        require(phase == PHASE_LOCKED);
        require(this.activeInputIndex == 0);
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        require(OpAuthOutputIdx(this.activeInputIndex, 0) == 0);
        require(tx.outputs[0].value > tx.inputs[this.activeInputIndex].value);
        validateVaultOutput(0, PHASE_LOCKED);
    }

    entrypoint function unvault(sig hotSig) {
        require(checkSig(hotSig, hotKey));
        require(phase == PHASE_LOCKED);
        require(this.activeInputIndex == 0);
        require(OpAuthOutputCount(this.activeInputIndex) == 1);
        require(OpAuthOutputIdx(this.activeInputIndex, 0) == 0);
        require(tx.outputs[0].value >= tx.inputs[this.activeInputIndex].value);
        validateVaultOutput(0, PHASE_UNVAULTING);
    }

    entrypoint function emergencySweep(sig coldSig, int destinationIndex) {
        require(checkSig(coldSig, coldKey));
        require(this.activeInputIndex == 0);
        require(OpAuthOutputCount(this.activeInputIndex) == 0);
        requireAmountAndDestinationIfNeeded(destinationIndex);
    }

    entrypoint function finalize(sig hotSig, int destinationIndex) {
        require(checkSig(hotSig, hotKey));
        require(phase == PHASE_UNVAULTING);
        require(this.age >= vaultUnvaultDelaySeconds);
        require(this.activeInputIndex == 0);
        require(OpAuthOutputCount(this.activeInputIndex) == 0);
        requireAmountAndDestinationIfNeeded(destinationIndex);
    }
}
