    "span": "contract TimeLockVault(\n    pubkey owner,\n    pubkey recovery,\n    int timeout\n) {\n    entrypoint function spend(sig s) {\n        // Owner can spend anytime with valid signature\n        require(checkSig(s, owner));\n    }\n\n    entrypoint function recover(sig s) {\n        // Recovery can spend only after timeout\n        require(checkSig(s, recovery));\n        require(tx.time >= timeout);\n    }\n\n    entrypoint function topUp() {\n        require(this.activeInputIndex == 0);\n        require(tx.outputs[0].value > tx.inputs[this.activeInputIndex].value);\n        require(tx.outputs[0].scriptPubKey == tx.inputs[this.activeInputIndex].scriptPubKey);\n    }\n}",
