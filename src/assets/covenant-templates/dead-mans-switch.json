    "span": "contract DeadManSwitch(pubkey owner, pubkey heir, int initInactivityPeriod) {\n    int inactivityPeriod = initInactivityPeriod;\n    \n    entrypoint function keepAlive(sig s) {\n        require(checkSig(s, owner));\n        require(tx.outputs[0].value >= tx.inputs[this.activeInputIndex].value - 1000);\n        validateOutputState(0, { inactivityPeriod: inactivityPeriod });\n    }\n    \n    entrypoint function claim(sig s) {\n        require(checkSig(s, heir));\n        require(this.age >= inactivityPeriod);\n    }\n}",
