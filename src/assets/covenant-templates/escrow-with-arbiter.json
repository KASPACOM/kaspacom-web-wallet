        "span": "entrypoint function arbitrate(pubkey pk, sig s, int amountToSeller) {\n        // Arbiter resolves dispute\n        require(blake2b(pk) == arbiterHash);\n        require(checkSig(s, pk));\n        \n        int total = tx.inputs[this.activeInputIndex].value;\n        int fee = 1000;\n        \n        // Verify splits\n        require(tx.outputs[0].value == amountToSeller);\n        require(tx.outputs[1].value == total - amountToSeller - fee);\n    }",
        "name_span": "arbitrate",
        "body_span": "require(blake2b(pk) == arbiterHash);\n        require(checkSig(s, pk));\n        \n        int total = tx.inputs[this.activeInputIndex].value;\n        int fee = 1000;\n        \n        // Verify splits\n        require(tx.outputs[0].value == amountToSeller);\n        require(tx.outputs[1].value == total - amountToSeller - fee);"
      }
    ],
    "span": "contract Escrow(\n    pubkey buyer,\n    pubkey seller,\n    byte[32] arbiterHash,\n    int expiry\n) {\n    entrypoint function release(sig buyerSig, sig sellerSig) {\n        // Both parties agree - release to seller\n        require(checkSig(buyerSig, buyer));\n        require(checkSig(sellerSig, seller));\n        \n        // Enforce output goes to seller\n        byte[34] sellerLock = new ScriptPubKeyP2PK(seller);\n        require(tx.outputs[0].scriptPubKey == sellerLock);\n    }\n\n    entrypoint function refund(sig s) {\n        // Buyer can refund after expiry\n        require(checkSig(s, buyer));\n        require(tx.time >= expiry);\n        \n        byte[34] buyerLock = new ScriptPubKeyP2PK(buyer);\n        require(tx.outputs[0].scriptPubKey == buyerLock);\n    }\n\n    entrypoint function arbitrate(pubkey pk, sig s, int amountToSeller) {\n        // Arbiter resolves dispute\n        require(blake2b(pk) == arbiterHash);\n        require(checkSig(s, pk));\n        \n        int total = tx.inputs[this.activeInputIndex].value;\n        int fee = 1000;\n        \n        // Verify splits\n        require(tx.outputs[0].value == amountToSeller);\n        require(tx.outputs[1].value == total - amountToSeller - fee);\n    }\n}",
    "name_span": "Escrow"
